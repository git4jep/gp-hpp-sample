# demo: local simulator; sandbox: actual GP API sandbox.
GP_MODE=demo
PUBLIC_BASE_URL=http://localhost:4200
# Browser origins allowed in addition to PUBLIC_BASE_URL; empty disables local access.
LOCAL_DEV_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5080,http://127.0.0.1:5080
GP_MERCHANT_ID=MER_d30e85f8e3d64aa9b4535b14e1c2095d
GP_APP_ID=8KR95sQLBorAJBAhsdxGxyn6GLO2RfEewWxjYbYKAP6DREvn
# Configure privately with python3 scripts/setup.py.
GP_APP_KEY=
GP_ACCOUNT_NAME=transaction_processing
GP_CURRENCY=USD
GP_COUNTRY=US
ADMIN_API_KEY=
DATABASE_PATH=data/merchant.sqlite
# sqlite remains the local default. SQL Server/Azure SQL never uses DATABASE_PATH.
DATABASE_PROVIDER=sqlite
# For Azure: Server=tcp:SERVER.database.windows.net,1433;Database=merchant;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;
DATABASE_CONNECTION_STRING=
